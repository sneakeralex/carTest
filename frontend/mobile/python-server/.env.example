# 服务启用/禁用配置
ENABLE_API_PROXY=True
ENABLE_SMS_SERVICE=True
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_DEBUG=False

# API代理服务器配置
TARGET_BASE_URL=https://172.16.229.88:443/
APP_KEY=your_app_key_here
APP_SECRET=your_app_secret_here

# 短信服务配置
SMS_APP_ID=your_sms_app_id_here
SMS_APP_KEY=your_sms_app_key_here
SMS_TEMPLATE_ID=your_template_id_here
SMS_SIGN_NAME=your_sign_name_here

# 验证码配置
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_EXPIRATION=300
VERIFICATION_CODE_RATE_LIMIT=60

# 数据库配置
DATABASE_PATH=./data/logs.db
AUTO_CLEANUP_DAYS=0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=python-server.log
ENABLE_SQLITE_LOG=True

# Gunicorn配置
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_LOG_LEVEL=info
GUNICORN_ACCESS_LOG=logs/access.log
GUNICORN_ERROR_LOG=logs/error.log
GUNICORN_PID_FILE=logs/gunicorn.pid
